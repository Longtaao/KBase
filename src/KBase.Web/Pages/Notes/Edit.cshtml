@page
@model KBase.Web.Pages.Notes.EditModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Id) ? "新建笔记" : "编辑笔记";
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post" class="vstack gap-3">
    <input type="hidden" asp-for="Id" />
    <div>
        <label class="form-label" asp-for="Title">标题</label>
        <input class="form-control" asp-for="Title" placeholder="笔记标题" />
    </div>
    <div>
        <label class="form-label" asp-for="Tags">标签（逗号分隔）</label>
        <input class="form-control" asp-for="Tags" placeholder="课程, 网络" />
    </div>
    <div>
        <label class="form-label" asp-for="Content">内容（Markdown，支持 [[双向链接]]）</label>
        <textarea class="form-control" asp-for="Content" rows="18" placeholder="# 标题&#10;&#10;正文… 引用其他笔记用 [[笔记标题]]"></textarea>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">💾 保存</button>
        <a class="btn btn-outline-secondary" asp-page="/Index">取消</a>
    </div>
</form>
